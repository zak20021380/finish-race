{
  "name": "detour-miniapp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "dev:worker": "wrangler dev --ip 127.0.0.1 --port 8787",
    "dev:all": "node scripts/dev-all.mjs",
    "build": "tsc --noEmit && npm run check:worker && node scripts/build-vite.mjs",
    "check:worker": "tsc -p worker/tsconfig.json",
    "preview": "vite preview --host",
    "test": "node scripts/run-tests.mjs",
    "test:countries": "node scripts/verify-countries.mjs"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vite": "^6.2.0",
    "wrangler": "^4.153.0"
  }
}
